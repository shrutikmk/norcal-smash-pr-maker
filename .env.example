# Copy to `.env` in this directory (repo root). Never commit `.env`.

# Required for start.gg GraphQL (tournaments, sets, PR Maker, calendar, ELO scrape).
STARTGG_API_KEY=

# Local vLLM Metal (Gemma 4) — required for PR Maker “Generate argument” and ranking demo AI.
# Start server: vllm serve "$HOME/models/gemma-4-26B-A4B" --port 8000 \
#   --served-model-name gemma-4-26B-A4B --reasoning-parser gemma4
VLLM_14B_BASE_URL=http://127.0.0.1:8000/v1
VLLM_14B_MODEL=gemma-4-26B-A4B

# --- Scraping performance tuning (all optional; see SCRAPING_PERFORMANCE.md) ---
# Rolling-window request cap (hard start.gg limit is 80/60s; keep margin).
STARTGG_MAX_RPM=70
# Minimum seconds between consecutive requests (steady-state ceiling ~75/min).
STARTGG_MIN_INTERVAL=0.8
# Max simultaneous in-flight requests (events fetched in parallel). The rate gate
# is still the global throttle; this just saturates it instead of paying latency
# per request. 8 is a good default; 12–16 squeezes a bit more on big regions.
STARTGG_CONCURRENCY=8
# Sets fetched per GraphQL page for the folded query. Validated against the live
# API: 40 is reliably stable; perPage 60 triggers start.gg "internal" errors and
# silent empty pages on this deeply-nested resolver. The code caps this at ~41.
STARTGG_SETS_PER_PAGE=40
# Set to 0/false to disable the concurrent asyncio engine (sequential fallback).
STARTGG_USE_ASYNC=1
# Assumed sets/event for --dry-run projections when real counts aren't known.
STARTGG_ESTIMATE_SETS_PER_EVENT=80

# --- OOR (out-of-region) pipeline tuning (all optional; see docs/oor-pipeline.md) ---
# Players fetched in parallel for user-facing requests (comparison/export).
OOR_FETCH_CONCURRENCY=3
# Players fetched in parallel by background warm jobs (lower = yields more
# rate-gate budget to the active comparison pair).
OOR_WARM_CONCURRENCY=2
# Set-history pages fetched in flight per player (after page 1).
OOR_SET_PAGE_CONCURRENCY=4
# Event standings maps fetched in flight per player.
OOR_STANDINGS_CONCURRENCY=4
# OOR set-history freshness threshold in seconds (default 7 days). Shorten if
# the PR window includes very recent events whose brackets may still change.
OOR_SETS_TTL_SEC=604800
